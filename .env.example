# ============================================================
# .env.example — Modèle de configuration locale
# TP2 Segmentation clients RFM (TAISS 2026)
# ============================================================
#
# Instructions :
#   1. Copier ce fichier en ".env" à la racine du projet :
#        cp .env.example .env
#   2. Remplacer les valeurs ci-dessous par vos propres valeurs.
#   3. NE JAMAIS versionner le fichier ".env" (il est déjà exclu via .gitignore).
#
# ============================================================

# Token d'authentification JupyterLab.
# Obligatoire — utilisé par docker-compose.yml pour sécuriser l'accès au conteneur.
# Générer un token fort, par exemple avec :
#   openssl rand -hex 32
JUPYTER_TOKEN=change_moi_avec_un_token_fort

# Port exposé sur la machine hôte pour accéder à JupyterLab.
# Modifier si le port 8888 est déjà utilisé sur votre machine.
JUPYTER_HOST_PORT=8888
